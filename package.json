{
  "name": "cordwipe",
  "nameFull": "CordWipe",
  "version": "0.1.0-dev.6",
  "description": "Find and delete your own Discord messages using your session. Processed locally; requests only to Discord. Confirm before deletion.",
  "userScript": {
    "namespace": "https://github.com/avizmarlon/cordwipe",
    "match": [
      "https://discord.com/*",
      "https://ptb.discord.com/*",
      "https://canary.discord.com/*"
    ],
    "run-at": "document-idle",
    "grant": "none",
    "updateURL": "https://raw.githubusercontent.com/avizmarlon/cordwipe/main/cordwipe.user.js",
    "downloadURL": "https://raw.githubusercontent.com/avizmarlon/cordwipe/main/cordwipe.user.js",
    "attribution": "Derived from Undiscord by victornpb and contributors (https://github.com/victornpb/undiscord)"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avizmarlon/cordwipe.git"
  },
  "bugs": {
    "url": "https://github.com/avizmarlon/cordwipe/issues"
  },
  "homepage": "https://github.com/avizmarlon/cordwipe",
  "author": "CordWipe contributors",
  "main": "cordwipe.user.js",
  "scripts": {
    "start": "npm run watch",
    "build": "node build/version.mjs && rollup -c",
    "watch": "node build/version.mjs && rollup -c -w",
    "test": "npm run lint && npm run test:unit && npm run build && npm run test:browser && npm run build:extension && npm run test:extension",
    "lint": "eslint src test build rollup.config.mjs --ext .js,.mjs",
    "lint:fix": "eslint src --fix",
    "test:unit": "node --test test/core.test.mjs test/build.test.mjs test/version.test.mjs",
    "check:version": "node build/version.mjs --check",
    "test:browser": "node --test test/browser.test.mjs",
    "build:extension": "npm run build && node build/extension.mjs && node build/package-extension.mjs",
    "test:extension": "node --test test/extension.test.mjs"
  },
  "files": [
    "cordwipe.user.js",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "delete",
    "messages",
    "discord",
    "wipe",
    "purge",
    "clean",
    "bulk"
  ],
  "devDependencies": {
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/pluginutils": "^5.4.0",
    "eslint": "^8.36.0",
    "fflate": "^0.8.3",
    "playwright": "^1.61.1",
    "rollup": "^3.20.2",
    "rollup-plugin-baked-env": "^1.0.1",
    "rollup-plugin-banner2": "^1.2.2",
    "rollup-plugin-serve": "^2.0.2",
    "tiny-dedent": "^1.0.2"
  },
  "type": "module",
  "private": true,
  "contributors": [
    "victornpb and Undiscord contributors"
  ]
}
