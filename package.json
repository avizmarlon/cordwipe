{
  "name": "cordwipe",
  "nameFull": "CordWipe [Development]",
  "version": "0.1.0-dev.1",
  "description": "Delete your own matching Discord messages with explicit scope and confirmation.",
  "userScript": {
    "namespace": "https://github.com/avizmarlon/cordwipe",
    "match": [
      "https://discord.com/channels/*",
      "https://ptb.discord.com/channels/*",
      "https://canary.discord.com/channels/*"
    ],
    "run-at": "document-idle",
    "grant": "none",
    "updateURL": "none",
    "attribution": "Derived from Undiscord by victornpb and contributors (https://github.com/victornpb/undiscord)"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avizmarlon/cordwipe.git"
  },
  "bugs": {
    "url": "https://github.com/avizmarlon/cordwipe/issues"
  },
  "homepage": "https://github.com/avizmarlon/cordwipe",
  "author": "CordWipe contributors",
  "main": "cordwipe.user.js",
  "scripts": {
    "start": "npm run watch",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "npm run lint && npm run test:unit && npm run build && npm run test:browser",
    "lint": "eslint src test build rollup.config.mjs --ext .js,.mjs",
    "lint:fix": "eslint src --fix",
    "version": "npm run build",
    "test:unit": "node --test test/core.test.mjs test/build.test.mjs",
    "test:browser": "node --test test/browser.test.mjs"
  },
  "files": [
    "cordwipe.user.js",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "delete",
    "messages",
    "discord",
    "wipe",
    "purge",
    "clean",
    "bulk"
  ],
  "devDependencies": {
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/pluginutils": "^5.4.0",
    "eslint": "^8.36.0",
    "playwright": "^1.61.1",
    "rollup": "^3.20.2",
    "rollup-plugin-baked-env": "^1.0.1",
    "rollup-plugin-banner2": "^1.2.2",
    "rollup-plugin-serve": "^2.0.2",
    "tiny-dedent": "^1.0.2"
  },
  "type": "module",
  "private": true,
  "contributors": [
    "victornpb and Undiscord contributors"
  ]
}
