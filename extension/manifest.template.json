{
  "manifest_version": 3,
  "name": "CordWipe (Development)",
  "description": "Find and delete your own Discord messages with explicit scope and confirmation.",
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/*",
        "https://ptb.discord.com/channels/*",
        "https://canary.discord.com/channels/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
